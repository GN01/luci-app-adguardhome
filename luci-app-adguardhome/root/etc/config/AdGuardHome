
config AdGuardHome 'AdGuardHome'
        option configpath '/etc/AdGuardHome.yaml'
        option workdir '/etc/AdGuardHome'
	option redirect 'dnsmasq-upstream'
        option logfile '/tmp/AdGuardHome.log'
        option verbose '0'
        option binpath '/usr/bin/AdGuardHome'
        option enabled '0'
        option core_version 'latest'
        option waitonboot '1'
	option upxflag '-9'
        option update_url 'https://github.com/AdguardTeam/AdGuardHome/releases/download/${Cloud_Version}/AdGuardHome_linux_${Arch}.tar.gz'
	option custom_ipset_enable '0'
	option custom_ipset_name 'adguardhome'
	option custom_ipset_file '/etc/AdGuardHome/custom_ipset.txt'
	option upstream_dns_file_enable '0'
	option upstream_dns_cn_upstream 'https://223.5.5.5/dns-query https://1.12.12.12/dns-query'
	option upstream_dns_default_upstreams 'https://dns.cloudflare.com/dns-query https://dns.google/dns-query'
	option upstream_dns_base_url_github 'https://raw.githubusercontent.com/Loyalsoldier/v2ray-rules-dat/release'
	option upstream_dns_base_url_cdn 'https://cdn.jsdelivr.net/gh/Loyalsoldier/v2ray-rules-dat@release'
	option upstream_dns_files 'direct-list.txt apple-cn.txt google-cn.txt'
	option upstream_dns_file '/etc/AdGuardHome/adguard_upstream_dns_file.txt'
